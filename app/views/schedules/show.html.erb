<div class = "title_object">
  <h1 class = "title">スケジュール管理アプリ</h1>
</div>

<div class = "container mt-4" style = "max-width: 700px;">
	<%= link_to schedules_path, class: "btn text-success text-decoration-none px-0 mb-2" do %>
		<i class = "bi bi-arrow-left"></i> 一覧に戻る
	<% end %>

	<div class = "mt-3 d-flex justify-content-between">
		<h2 class = "schedule_title"><%= @schedule.title %></h2>
		<%= link_to edit_schedule_path(@schedule), class: "btn btn-outline-success px-4" do %>
			<i class = "bi bi-pencil me-1"></i>編集
		<% end %>
	</div>

	<div class = "card p-4 shadow-sm mt-3">
		<table class = "table table-bordered mb-0  align-middle">
			<tbody>
				<tr>
					<th class = "text-center bg-light w-25 text-muted small px-3 py-3">開始日</th>
					<td class = "px-3 py-3 text-muted"><%= @schedule.start_date.present? ? @schedule.start_date.strftime("%Y/%m/%d") : "" %></td>
				</tr>
				<tr>
					<th class = "text-center bg-light w-25 text-muted small px-3 py-3">終了日</th>
					<td class = "px-3 py-3 text-muted"><%= @schedule.end_date.present? ? @schedule.end_date.strftime("%Y/%m/%d") : "" %></td>
				</tr>
				<tr>
					<th class = "text-center bg-light w-25 text-muted small px-3 py-3">終日</th>
					<td class = "px-3 py-3 text-muted fs-3"><%= @schedule.all_day ? "○" : "" %></td>
				</tr>
				<tr>
					<th class = "text-center bg-light w-25 text-muted small px-3 py-3">スケジュールメモ</th>
					<td class = "px-3 py-3 text-muted"><%= @schedule.description %></td>
				</tr>
			</tbody>
		</table>
	</div>
</div>