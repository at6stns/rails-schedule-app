<div class = "title_object">
  <h1 class = "title">スケジュール管理アプリ</h1>
</div>

<div class = "container mt-4" style="max-width: 600px;">
  <h2 class = "sub_title">予定を編集してください</h2>

  <div class = "card p-4 shadow-sm">
    <%= form_with model: @schedule do |f| %>
      <p class = "fw-bold mb-1 text-muted">タイトル<span class = "span_form">＊</span></p>
      <%= f.text_field :title, class: "form-control mb-3", placeholder: "タイトル" %>
      <% if @schedule.errors[:title].any? %>
        <p class = "text-danger small mb-2">
           <%= @schedule.errors[:title].first %>
       </p>
      <% end %>

      <div class = "row g-2">
      <div class = "col-md-6">
        <p class = "fw-bold mb-1 text-muted">開始日<span class = "span_form">＊</span></p>
        <%= f.date_field :start_date, id: "start_date",
          class: "form-control form-control mb-2",
          placeholder: "---- / -- / --" %>

        <% if @schedule.errors[:start_date].any? %>
          <p class = "text-danger small mb-2">
            <%= @schedule.errors[:start_date].first %>
          </p>
        <% end %>
      </div>

      <div class = "col-md-6">
        <p class = "fw-bold mb-1 text-muted">終了日<span class = "span_form">＊</span></p>
        <%= f.date_field :end_date, id: "end_date",
          class: "form-control form-control mb-2",
          placeholder: "---- / -- / --" %>

        <% if @schedule.errors[:end_date].any? %>
          <p class = "text-danger small mb-2">
            <%= @schedule.errors[:end_date].first %>
          </p>
        <% end %>
      </div>
  </div>

      <div class = "form-check my-3 check">
        <%= f.check_box :all_day , class: "form-check-input", id: "all_day_check"%> <%= label_tag "all_day_check", "終日の場合はチェックを入れます", class: "form-check-label" %>
      </div>

      <p class = "fw-bold mb-1 text-muted">スケジュールメモ</p>
      <%= f.text_area :description, class: "form-control mb-3", rows: 4, placeholder: "メモを入力する"%>

      <% if @schedule.errors[:description].any? %>
        <p class = "text-danger small mb-2">
          <%= @schedule.errors[:description].first %>
        </p>
      <% end %>


      <div class = "d-flex justify-content-end gap-2 mt-3">
        <%= link_to "キャンセル", schedules_path, class: "btn btn-outline-secondary" %>
        <%= f.submit "保存", class: "btn btn-success", data:{ turbo: false } %>
      </div>

    <% end %>

  </div>
</div>